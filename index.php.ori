<body>
<h2>Detail Digital Signature</h2>
<hr size="1">
<form name="tamu" method="post" action="simpan.php">
Nama Klien  <input  style="margin: 5px 5px 5px 24px;" type="text" name="name"><br>
Email  <input style="margin: 5px 5px 5px 24px;" type="text" name="email"><br>
Keterangan  <input style="margin: 5px 5px 5px 24px;" type="text" name="address"><br>
Kota  <input style="margin: 5px 5px 5px 24px;" type="text" name="city"><br>
Angka Acak <input style="margin: 5px 5px 5px 24px;" type="text"  name="msg"><br>
<input type="submit" name="submit" value="Send"> <input type="reset" name="reset" value="Reset">
</form>
</body>
</html>